# Beispielkonfiguration. NIEMALS echte Zugangsdaten in dieses Repository committen!
# Lokal: kopieren nach .env und Werte anpassen. Produktion: Variablen in Coolify setzen.

# PostgreSQL
DATABASE_URL="postgres://antonia:CHANGE_ME@localhost:5432/antonia"

# Redis
REDIS_URL="redis://:CHANGE_ME@localhost:6379/0"

# Mind. 32 zufällige Zeichen, z. B. erzeugt mit: openssl rand -base64 48
# Nach der Einrichtung NICHT mehr ändern (sonst muss 2FA neu eingerichtet werden).
APP_SECRET="CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME"

# Nur für die Ersteinrichtung unter /setup (mind. 16 Zeichen). Danach entfernen.
SETUP_TOKEN="CHANGE_ME_SETUP_TOKEN"

# debug | info | warn | error
LOG_LEVEL="info"

# --- Nur Produktion (hinter Coolify/Traefik) ---
# PROTOCOL_HEADER="x-forwarded-proto"
# HOST_HEADER="x-forwarded-host"
# ADDRESS_HEADER="X-Forwarded-For"
# XFF_DEPTH="1"
